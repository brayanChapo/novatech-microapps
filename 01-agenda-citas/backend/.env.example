# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Valores locales: los imprime `supabase start` (API URL y service_role key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=reemplazar-por-service-role-key
SUPABASE_ANON_KEY=reemplazar-por-anon-key

# WhatsApp Business Cloud API (Meta)
META_WA_TOKEN=reemplazar-por-token-wa
META_WA_PHONE_ID=reemplazar-por-phone-number-id
META_WA_WEBHOOK_TOKEN=reemplazar-por-token-verificacion-webhook

# Resend — correo transaccional
RESEND_API_KEY=re_xxxxxxxxxxxx

# Orígenes permitidos (frontend). Separar por comas.
CORS_ORIGINS=http://localhost:3000

# Secret para proteger el endpoint de cron
CRON_SECRET=reemplazar-por-secreto-cron

PORT=4001
