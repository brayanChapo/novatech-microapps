# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Valores locales: los imprime `supabase start` (API URL y service_role key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=reemplazar-por-service-role-key
# Orígenes permitidos (dashboard web). Separar por comas.
CORS_ORIGINS=http://localhost:3000
PORT=4000
